<?xml version="1.0"?>
<robot name="hospital_delivery_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="body_length" value="0.83"/>
  <xacro:property name="body_width" value="0.71"/>
  <xacro:property name="body_height" value="0.91"/>

  <xacro:property name="wheel_separation" value="0.35"/>
  <xacro:property name="drive_wheel_diameter" value="0.125"/>
  <xacro:property name="drive_wheel_radius" value="0.0625"/>
  <xacro:property name="drive_wheel_thickness" value="0.04"/>
  <xacro:property name="body_mount_shift_x" value="-0.16"/>

  <xacro:property name="lidar_size" value="0.037 0.037 0.024"/>
  <xacro:property name="imu_size" value="0.045 0.035 0.018"/>
  <xacro:property name="tof_size" value="0.035 0.02 0.02"/>
  <xacro:property name="tof_direction_size" value="0.08 0.008 0.008"/>

  <xacro:property name="lidar_x" value="0.27"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="0.175"/>

  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="0.015"/>

  <xacro:property name="tof_front_left_x" value="0.22"/>
  <xacro:property name="tof_front_left_y" value="0.37"/>
  <xacro:property name="tof_front_left_z" value="0.15"/>
  <xacro:property name="tof_front_left_yaw" value="0.209440"/>

  <xacro:property name="tof_front_right_x" value="0.22"/>
  <xacro:property name="tof_front_right_y" value="-0.37"/>
  <xacro:property name="tof_front_right_z" value="0.15"/>
  <xacro:property name="tof_front_right_yaw" value="-0.209440"/>

  <xacro:property name="tof_rear_left_x" value="-0.55"/>
  <xacro:property name="tof_rear_left_y" value="0.32"/>
  <xacro:property name="tof_rear_left_z" value="0.15"/>
  <xacro:property name="tof_rear_left_yaw" value="2.932153"/>

  <xacro:property name="tof_rear_right_x" value="-0.55"/>
  <xacro:property name="tof_rear_right_y" value="-0.32"/>
  <xacro:property name="tof_rear_right_z" value="0.15"/>
  <xacro:property name="tof_rear_right_yaw" value="-2.932153"/>

  <xacro:property name="tof_rear_center_x" value="-0.60"/>
  <xacro:property name="tof_rear_center_y" value="0.0"/>
  <xacro:property name="tof_rear_center_z" value="0.15"/>
  <xacro:property name="tof_rear_center_yaw" value="3.141593"/>

  <material name="body_gray">
    <color rgba="0.55 0.58 0.62 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.04 0.04 0.04 1.0"/>
  </material>
  <material name="lidar_blue">
    <color rgba="0.1 0.35 0.95 1.0"/>
  </material>
  <material name="imu_green">
    <color rgba="0.0 0.65 0.25 1.0"/>
  </material>
  <material name="tof_orange">
    <color rgba="1.0 0.45 0.05 1.0"/>
  </material>
  <material name="tof_direction_yellow">
    <color rgba="1.0 0.9 0.1 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${drive_wheel_diameter}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- TODO: Replace body primitive with Fusion 360 STL or DAE mesh after export. -->
    <visual>
      <origin xyz="${body_mount_shift_x} 0 0.43" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="body_gray"/>
    </visual>
    <collision>
      <origin xyz="${body_mount_shift_x} 0 0.43" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${body_mount_shift_x} 0 0.43" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.8" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_thickness}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_thickness}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} ${drive_wheel_radius - drive_wheel_diameter}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left" y="${wheel_separation / 2.0}"/>
  <xacro:drive_wheel side="right" y="${-wheel_separation / 2.0}"/>

  <!-- TODO: Add caster link and joint after caster wheel position is finalized. -->

  <link name="laser_frame">
    <visual>
      <geometry>
        <box size="${lidar_size}"/>
      </geometry>
      <material name="lidar_blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${lidar_size}"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 ${pi}"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="${imu_size}"/>
      </geometry>
      <material name="imu_green"/>
    </visual>
    <collision>
      <geometry>
        <box size="${imu_size}"/>
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="tof_sensor" params="name x y z yaw">
    <link name="${name}">
      <visual>
        <geometry>
          <box size="${tof_size}"/>
        </geometry>
        <material name="tof_orange"/>
      </visual>
      <visual>
        <origin xyz="0.055 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${tof_direction_size}"/>
        </geometry>
        <material name="tof_direction_yellow"/>
      </visual>
      <collision>
        <geometry>
          <box size="${tof_size}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}"/>
    </joint>
  </xacro:macro>

  <xacro:tof_sensor
    name="tof_front_left_link"
    x="${tof_front_left_x}"
    y="${tof_front_left_y}"
    z="${tof_front_left_z}"
    yaw="${tof_front_left_yaw}"/>
  <xacro:tof_sensor
    name="tof_front_right_link"
    x="${tof_front_right_x}"
    y="${tof_front_right_y}"
    z="${tof_front_right_z}"
    yaw="${tof_front_right_yaw}"/>
  <xacro:tof_sensor
    name="tof_rear_left_link"
    x="${tof_rear_left_x}"
    y="${tof_rear_left_y}"
    z="${tof_rear_left_z}"
    yaw="${tof_rear_left_yaw}"/>
  <xacro:tof_sensor
    name="tof_rear_right_link"
    x="${tof_rear_right_x}"
    y="${tof_rear_right_y}"
    z="${tof_rear_right_z}"
    yaw="${tof_rear_right_yaw}"/>
  <xacro:tof_sensor
    name="tof_rear_center_link"
    x="${tof_rear_center_x}"
    y="${tof_rear_center_y}"
    z="${tof_rear_center_z}"
    yaw="${tof_rear_center_yaw}"/>
</robot>
